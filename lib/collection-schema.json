{
  "$defs": {
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "description": {
      "type": "object",
      "patternProperties": {
        "^([a-z]{1,8}(-[a-z0-9]{1,8})*-?)$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "distributions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "$ref": "#/$defs/url"
          },
          "download": {
            "$ref": "#/$defs/url"
          },
          "format": {
            "$ref": "#/$defs/url"
          }
        }
      }
    },
    "db": {
      "type": "string",
      "pattern": "^Q[1-9][0-9]*$"
    },
    "license": {
      "$ref": "#/$defs/url"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "partOf": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/url"
      },
      "minItems": 1,
      "maxItems": 1,
      "x-derived": true
    },
    "url": {
      "$ref": "#/$defs/url"
    },
    "type": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+:[a-zA-Z]+$"
      },
      "x-derived": true
    },
    "uri": {
      "$ref": "#/$defs/url",
      "x-derived": true
    },
    "id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "x-derived": true
    }
  },
  "required": [
    "id",
    "uri",
    "name"
  ]
}
